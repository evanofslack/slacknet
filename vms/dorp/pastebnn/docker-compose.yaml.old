version: "3.7"
services:
  redis:
    container_name: pastebnn-redis
    image: redis:latest
    restart: unless-stopped
    ports:
      - 6383:6379
  server:
    image: evanofslack/pastebnn:latest
    container_name: pastebnn
    restart: unless-stopped
    environment:
      PASTEBNN_LOG_LEVEL: "debug"
      PASTEBNN_STORAGE_BACKEND: "redis"
      PASTEBNN_REDIS_HOST: "redis"
      PASTEBNN_REDIS_PORT: 6379
      PASTEBNN_MAX_SIZE_BYTES: 1048576 # 1MB
      PASTEBNN_APP_URL: "bin.evanslack.dev"
    ports:
      - 8993:8080
    depends_on:
      - "redis"

