{
    #debug
        admin :2019 {
                origins 10.33.1.114
        }
        servers {
                metrics
        }
        email evan.slack@outlook.com
}

(dnsauth) {
        tls {
                dns cloudflare {env.CF_API_TOKEN}
                # ca https://acme-staging-v02.api.letsencrypt.org/directory
        }
}

*.local.{$DOMAIN}, *.{$DOMAIN}, {$DOMAIN} {
        # get certs from cloudflare DNS challenge
        import dnsauth


        # -------
        #  TORRR
        # -------

        @jellyseerr host jellyseerr.{$DOMAIN}
        handle @jellyseerr {
                reverse_proxy {$TORRR_ADDR}:5055
        }

        @openbooks host openbooks.{$DOMAIN}
        handle @openbooks {
                reverse_proxy {$TORRR_ADDR}:8071
        }

        @wizzar host wizzar.{$DOMAIN}
        handle @wizzar {
                reverse_proxy {$TORRR_ADDR}:5690
        }

        # ---------
        #  NUBUNTU
        # ---------

        @change_detection host change.{$DOMAIN}
        handle @change_detection {
                reverse_proxy {$NUBUNTU_ADDR}:5000
        }

        @filebrowser host filebrowser.{$DOMAIN}
        handle @filebrowser {
                reverse_proxy {$NUBUNTU_ADDR}:8087
        }

        @immich host immich.{$DOMAIN}
        handle @immich {
                reverse_proxy {$NUBUNTU_ADDR}:2283
        }

        @pastebnn host bin.{$DOMAIN}
        handle @pastebnn {
                reverse_proxy {$NUBUNTU_ADDR}:8993
        }

        @send host send.{$DOMAIN}
        handle @send {
                reverse_proxy {$NUBUNTU_ADDR}:1234
        }

        @snapdrop host snapdrop.{$DOMAIN}
        handle @snapdrop {
                reverse_proxy {$NUBUNTU_ADDR}:9999
        }

        # -------
        #  VED
        # -------

        @analogdb host analogdb.local.{$DOMAIN}
        handle @analogdb {
                reverse_proxy {$VED_ADDR}:3000
        }

        @analogdb-api host api.analogdb.local.{$DOMAIN}
        handle @analogdb-api {
                reverse_proxy {$VED_ADDR}:8080
        }

        # -------
        #  JOULE
        # -------

        @jellyfin host jellyfin.{$DOMAIN}
        handle @jellyfin {
                reverse_proxy {$JOULE_ADDR}:8096
        }
}

