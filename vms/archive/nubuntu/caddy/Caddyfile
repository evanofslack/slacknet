(dnsauth) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		# ca https://acme-staging-v02.api.letsencrypt.org/directory
	}
}

*.local.{$DOMAIN}, *.{$DOMAIN}, {$DOMAIN} {
	# get certs from cloudflare DNS challenge
	import dnsauth

	# only allow local access
	@denied not remote_ip private_ranges
	abort @denied


	# ---------
	#  SCALE
	# ---------

	@scale host scale.local.{$DOMAIN}
	handle @scale {
		reverse_proxy {$SCALE_ADDR}:80
	}

	# ---------
	#  PVE-NAVI
	# ---------

	@pvenavi host pve-navi.local.{$DOMAIN}
	handle @pvenavi {
		reverse_proxy {$PVENAVI_ADDR}:8006 {
        transport http {
            tls_insecure_skip_verify
            }
        }
	}

	# ---------
	#  PBS
	# ---------

	@pbs host pbs.local.{$DOMAIN}
	handle @pbs {
		reverse_proxy {$PBS_ADDR}:8007 {
        transport http {
            tls_insecure_skip_verify
            }
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}
        }
	}

